{
  "name": "auth-backend",
  "version": "1.0.0",
  "description": "Authentication backend with Express, Mongoose, and MongoDB Atlas",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
